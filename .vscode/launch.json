{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Run Current File",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/scripts/run-current-file.cjs",
            "args": [
                "${file}"
            ],
            "cwd": "${fileDirname}",
            "autoAttachChildProcesses": true,
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Run Current E2E Test",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${fileDirname}/../node_modules/jest/bin/jest.js",
            "args": [
                "--config",
                "${fileDirname}/jest-e2e.json",
                "--runInBand",
                "--runTestsByPath",
                "${file}"
            ],
            "cwd": "${fileDirname}",
            "envFile": "${fileDirname}/../.env",
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "vscode-jest-tests.v2",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeArgs": [
                "--experimental-vm-modules"
            ],
            "program": "${workspaceFolder}/test/node_modules/jest/bin/jest.js",
            "args": [
                "--config",
                "${workspaceFolder}/test/jest.config.ts",
                "--runInBand",
                "--watchAll=false",
                "--testNamePattern",
                "${jest.testNamePattern}",
                "--runTestsByPath",
                "${jest.testFile}"
            ],
            "cwd": "${workspaceFolder}/test",
            "envFile": "${workspaceFolder}/test/.env",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}
