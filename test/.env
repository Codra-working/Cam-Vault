      # Cam-Vault env #
      ## Gateway ##
      ### GateWay options ###
      GATEWAY_TCP_HOST=0.0.0.0
      GATEWAY_TCP_PORT=3000
      RECORDING_SERVICE_HOST= localhost
      RECORDING_SERVICE_PORT= 3001
      STORAGE_SERVICE_HOST= localhost
      STORAGE_SERVICE_PORT= 8333
      VIDEO_METADATA_SERVICE_BASE_URL= http://localhost:8080/api/v1

      ## RecordingService ##
      ### RecordingService ip options ###
      RECORDING_TCP_HOST= 0.0.0.0
      RECORDING_TCP_PORT= 3001

      ### RecordingService recording options ###
      RECORDING_STREAMS= rtsp://210.99.70.120:1935/live/cctv001.stream
      RECORDING_CRON= "* * * * *"
      RECORDING_SEGMENT_LENGTH= 30
      RECORDING_TZ= Asia/Seoul

      ### DB options ###
      DB_HOST= localhost
      DB_PORT= 3306
      DB_NAME= recording_service
      DB_USERNAME= root
      DB_PASSWORD= root
      DB_SYNCHRONIZE= true
      

      ### RMQ options ###
      RMQ_URL= amqp://localhost:5672
      RMQ_QUEUE_NAME= encoding_queue

      ### S3 storage options ###
      S3_ENDPOINT_IP= http://localhost
      S3_ENDPOINT_PORT=8333
      S3_REGION= us-east-1
      S3_FORCE_PATH_STYLE= 'true'
      S3_USE_DUALSTACK_ENDPOINT= 'false'
      S3_TARGET_DIR= /app/storage/recordings
      S3_RESPONSE_CHECKSUM_VALIDATION= WHEN_REQUIRED
      S3_REQUEST_CHECKSUM_CALCULATION= WHEN_REQUIRED
      S3_CREDENTIALS_ACCESS_KEY_ID= admin
      S3_CREDENTIALS_SECRET_ACCESS_KEY= secret