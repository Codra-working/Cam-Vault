      ### RecordingService ip options ###
      RECORDING_TCP_HOST= 0.0.0.0
      RECORDING_TCP_PORT= 3001

      ### RecordingService recording options ###
      RECORDING_CRON= "* * * * *"
      RECORDING_VIDEO_LENGTH= 30
      RECORDING_TZ= Asia/Seoul

      ### DB options ###
      DB_HOST= mysql
      DB_PORT= 3306
      DB_NAME= recording_service
      DB_USERNAME= root
      DB_PASSWORD= root
      DB_SYNCHRONIZE= true

      ### RMQ options ###
      RMQ_URL= amqp=//rabbitmq:5672
      RMQ_QUEUE_NAME= encoding_queue

      ### S3 storage options ###
      S3_ENDPOINT= http://storage:8333
      S3_REGION= us-east-1
      S3_FORCE_PATH_STYLE= 'true'
      S3_USE_DUALSTACK_ENDPOINT= 'false'
      S3_TARGET_DIR= /app/storage/recordings
      S3_RESPONSE_CHECKSUM_VALIDATION= WHEN_REQUIRED
      S3_REQUEST_CHECKSUM_CALCULATION= WHEN_REQUIRED
      S3_CREDENTIALS_ACESS_KEY_ID= admin
      S3_CREDENTIALS_SECRET_ACESS_KEY= secret