{
  "name": "@cam-vault/recording",
  "version": "1.0.0",
  "description": "records video from rtsp stream",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "nest start",
    "start:dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:debug": "nest start --debug localhost:9230 --watch",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/lib-storage": "^3.1071.0",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/microservices": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "mysql2": "^3.22.3",
    "node-av": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.0.0",
    "typescript": "^6.0.3",
    "yellowstone": "file:./packages/yellowstone"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "globals": "17.12.0",
    "jest-mock": "^30.4.1",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.10",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "8.70.0"
  },
  "overrides": {
    "multer": "^2.2.0",
    "js-yaml": "4.2.0",
    "werift": {
      "ip": "npm:neoip@2.1.0"
    },
    "werift-ice": {
      "ip": "npm:neoip@2.1.0"
    }
  }
}
